// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`assembleArgs > chains xfade and acrossfade with the planned offsets and encodes the compatible preset 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-i",
  "/r/0.mkv",
  "-i",
  "/r/1.mkv",
  "-i",
  "/r/2.mkv",
  "-filter_complex",
  "[0:v][1:v]xfade=transition=fade:duration=0.5:offset=5.5[v1];[0:a][1:a]acrossfade=d=0.5:c1=tri:c2=tri[a1];[v1][2:v]xfade=transition=fade:duration=0.5:offset=9[vout];[a1][2:a]acrossfade=d=0.5:c1=tri:c2=tri[aout]",
  "-map",
  "[vout]",
  "-map",
  "[aout]",
  "-c:v",
  "libx264",
  "-preset",
  "medium",
  "-profile:v",
  "high",
  "-crf",
  "20",
  "-pix_fmt",
  "yuv420p",
  "-color_primaries",
  "bt709",
  "-color_trc",
  "bt709",
  "-colorspace",
  "bt709",
  "-c:a",
  "aac",
  "-b:a",
  "192k",
  "-ar",
  "48000",
  "-ac",
  "2",
  "-movflags",
  "+faststart",
  "-progress",
  "pipe:1",
  "-nostats",
  "/out/x.mp4",
]
`;

exports[`ingest and loudness args > builds proxy, filmstrip and loudness commands 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-i",
  "/c/original.mov",
  "-map",
  "0:v:0",
  "-map",
  "0:a:0?",
  "-vf",
  "zscale=tin=arib-std-b67:pin=bt2020:min=bt2020nc:t=linear:npl=100,format=gbrpf32le,zscale=p=bt709,tonemap=tonemap=hable:desat=0,zscale=t=bt709:m=bt709:r=tv,scale='min(720,iw)':-2,format=yuv420p",
  "-c:v",
  "libx264",
  "-preset",
  "veryfast",
  "-crf",
  "28",
  "-force_key_frames",
  "expr:gte(t,n_forced*1)",
  "-c:a",
  "aac",
  "-b:a",
  "96k",
  "-ac",
  "2",
  "-movflags",
  "+faststart",
  "/c/proxy.mp4",
]
`;

exports[`ingest and loudness args > builds proxy, filmstrip and loudness commands 2`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-i",
  "/c/proxy.mp4",
  "-vf",
  "fps=0.833,scale=-2:120,tile=10x1",
  "-frames:v",
  "1",
  "-q:v",
  "4",
  "/c/strip.jpg",
]
`;

exports[`ingest and loudness args > builds proxy, filmstrip and loudness commands 3`] = `
[
  "-hide_banner",
  "-nostdin",
  "-vn",
  "-ss",
  "0",
  "-t",
  "2",
  "-i",
  "/c/original.mov",
  "-ss",
  "5",
  "-t",
  "3",
  "-i",
  "/c/original.mov",
  "-filter_complex",
  "[0:a][1:a]concat=n=2:v=0:a=1,loudnorm=I=-16:TP=-1.5:LRA=11:print_format=json[m]",
  "-map",
  "[m]",
  "-f",
  "null",
  "-",
]
`;

exports[`segmentArgs > normalizes an SDR clip with blur fill, overlay and gain 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-ss",
  "1.5",
  "-t",
  "6",
  "-i",
  "/data/session/clips/a/original.mov",
  "-filter_complex",
  "[0:v]setpts=PTS-STARTPTS,fps=30,tpad=stop_mode=clone:stop_duration=1,split=2[bg][fg];[bg]scale=480:270:force_original_aspect_ratio=increase,crop=480:270,gblur=sigma=12,eq=brightness=-0.12,scale=1920:1080,setsar=1[bgb];[fg]scale=1920:1080:force_original_aspect_ratio=decrease:force_divisible_by=2,setsar=1[fgs];[bgb][fgs]overlay=(W-w)/2:(H-h)/2,drawtext=fontfile='/fonts/NotoSans-Regular.ttf':textfile='/r/0-place.txt':expansion=none:fontcolor=white:fontsize=49:x=43:y=934:shadowcolor=black@0.55:shadowx=2:shadowy=2:alpha='if(lt(t,0.3),t/0.3,if(lt(t,3.5),1,max(0,(4-t)/0.5)))':enable='lt(t,4)',drawtext=fontfile='/fonts/NotoSans-Regular.ttf':textfile='/r/0-date.txt':expansion=none:fontcolor=white:fontsize=37:x=43:y=1000:shadowcolor=black@0.55:shadowx=2:shadowy=2:alpha='if(lt(t,0.3),t/0.3,if(lt(t,3.5),1,max(0,(4-t)/0.5)))':enable='lt(t,4)',format=yuv420p[v];[0:a]asetpts=PTS-STARTPTS,aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,volume=3.2dB,apad[a]",
  "-map",
  "[v]",
  "-map",
  "[a]",
  "-t",
  "6",
  "-c:v",
  "libx264",
  "-preset",
  "veryfast",
  "-crf",
  "12",
  "-pix_fmt",
  "yuv420p",
  "-color_primaries",
  "bt709",
  "-color_trc",
  "bt709",
  "-colorspace",
  "bt709",
  "-c:a",
  "pcm_s16le",
  "-progress",
  "pipe:1",
  "-nostats",
  "-f",
  "matroska",
  "/r/0.mkv",
]
`;

exports[`segmentArgs > renders a title card on black with the date range below 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-y",
  "-loglevel",
  "error",
  "-f",
  "lavfi",
  "-i",
  "color=c=black:s=1920x1080:r=30:d=3",
  "-f",
  "lavfi",
  "-t",
  "3",
  "-i",
  "anullsrc=r=48000:cl=stereo",
  "-filter_complex",
  "[0:v]setsar=1,drawtext=fontfile='/fonts/NotoSans-Regular.ttf':textfile='/r/t-title.txt':expansion=none:fontcolor=white:fontsize=76:x=(w-text_w)/2:y=(h-text_h)/2-34:shadowcolor=black@0.55:shadowx=2:shadowy=2,drawtext=fontfile='/fonts/NotoSans-Regular.ttf':textfile='/r/t-sub.txt':expansion=none:fontcolor=white:fontsize=38:x=(w-text_w)/2:y=(h/2)+46:shadowcolor=black@0.55:shadowx=2:shadowy=2,format=yuv420p[v];[1:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo[a]",
  "-map",
  "[v]",
  "-map",
  "[a]",
  "-t",
  "3",
  "-c:v",
  "libx264",
  "-preset",
  "veryfast",
  "-crf",
  "12",
  "-pix_fmt",
  "yuv420p",
  "-color_primaries",
  "bt709",
  "-color_trc",
  "bt709",
  "-colorspace",
  "bt709",
  "-c:a",
  "pcm_s16le",
  "-progress",
  "pipe:1",
  "-nostats",
  "-f",
  "matroska",
  "/r/t.mkv",
]
`;

