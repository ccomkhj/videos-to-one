// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`frame sampling > reads six frames and turns each four ways for the face detector 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-loglevel",
  "error",
  "-ss",
  "1.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "3.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "5.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "7.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "9.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "11.000",
  "-i",
  "/c/proxy.mp4",
  "-filter_complex",
  "[0:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s0];[1:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s1];[2:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s2];[3:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s3];[4:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s4];[5:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s5];[s0][s1][s2][s3][s4][s5]concat=n=6:v=1:a=0[f];[f]split=4[r0][r1][r2][r3];[r0]scale=320:240:force_original_aspect_ratio=decrease,pad=320:240:(ow-iw)/2:(oh-ih)/2,setsar=1[o0];[r1]transpose=clock,scale=320:240:force_original_aspect_ratio=decrease,pad=320:240:(ow-iw)/2:(oh-ih)/2,setsar=1[o1];[r2]hflip,vflip,scale=320:240:force_original_aspect_ratio=decrease,pad=320:240:(ow-iw)/2:(oh-ih)/2,setsar=1[o2];[r3]transpose=cclock,scale=320:240:force_original_aspect_ratio=decrease,pad=320:240:(ow-iw)/2:(oh-ih)/2,setsar=1[o3];[o0][o1][o2][o3]concat=n=4:v=1:a=0,format=rgb24[out]",
  "-map",
  "[out]",
  "-fps_mode",
  "passthrough",
  "-f",
  "rawvideo",
  "-pix_fmt",
  "rgb24",
  "pipe:1",
]
`;

exports[`frame sampling > squashes and center-crops for the CNN 1`] = `
[
  "-hide_banner",
  "-nostdin",
  "-loglevel",
  "error",
  "-ss",
  "1.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "3.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "5.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "7.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "9.000",
  "-i",
  "/c/proxy.mp4",
  "-ss",
  "11.000",
  "-i",
  "/c/proxy.mp4",
  "-filter_complex",
  "[0:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s0];[1:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s1];[2:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s2];[3:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s3];[4:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s4];[5:v]trim=end_frame=1,setpts=PTS-STARTPTS,setsar=1[s5];[s0][s1][s2][s3][s4][s5]concat=n=6:v=1:a=0[f];[f]scale=416:416,crop=384:384,format=rgb24[out]",
  "-map",
  "[out]",
  "-fps_mode",
  "passthrough",
  "-f",
  "rawvideo",
  "-pix_fmt",
  "rgb24",
  "pipe:1",
]
`;
